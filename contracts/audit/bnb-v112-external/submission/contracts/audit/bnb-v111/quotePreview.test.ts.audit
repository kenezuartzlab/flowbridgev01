import { expect,it } from 'vitest';
import { previewTierChoice,PreviewDraft,type TierObservation,type PreviewContext } from './quotePreview';
const W='0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c',U='0x55d398326f99059fF775485246999027B3197955',R='0x1b81D678ffb9C0263b24A97847620C99d213eB14',H=`0x${'11'.repeat(32)}`;
const context:PreviewContext={chainId:56,tokenIn:W,tokenOut:U,amountIn:'1000000000000000',blockNumber:100,blockHash:H,nowSeconds:1000,proposalFeeBps:5,paused:false};
const row=(tier:500|2500,grossOutput='600000000000000000'):TierObservation=>({chainId:56,tokenIn:W,tokenOut:U,router:R,tier,amountIn:context.amountIn,grossOutput,wholeSwapGas:'200000',gasPriceWei:'50000000',outputPerBnb:'600000000000000000000',quotedAtSeconds:1000,blockNumber:100,blockHash:H,factoryVerified:true,source:'LOCAL_FORK_SIMULATION'});
const rows=()=>[row(500),row(2500,'590000000000000000')];
it('selects higher net after fee and whole gas once, still never executable',()=>{const x=previewTierChoice(rows(),context);expect(x.selectedTier).toBe(500);expect(x.executable).toBe(false);expect(x.approved).toBe(false);if('costs'in x){expect(x.costs[0]?.proposalFeeOutput).toBe('300000000000000');expect(x.costs[0]?.simulatedGasOutput).toBe('6000000000000000');expect(x.costs[0]?.netAfterFeeAndGas).toBe('593700000000000000');}});
it('can select 2500 when genuinely better instead of pinning 500',()=>{expect(previewTierChoice([row(500),row(2500,'610000000000000000')],context).selectedTier).toBe(2500);});
it('ties never claim a winner',()=>{expect(previewTierChoice([row(500),row(2500)],context).status).toBe('TIE');});
it('31 seconds invalidates quote',()=>{expect(previewTierChoice(rows(),{...context,nowSeconds:1031}).status).toBe('STALE_OR_REORG');});
it('reorg invalidates quote',()=>{expect(previewTierChoice(rows(),{...context,blockHash:`0x${'22'.repeat(32)}`}).status).toBe('STALE_OR_REORG');});
it('changed block invalidates quote',()=>{expect(previewTierChoice(rows(),{...context,blockNumber:101}).status).toBe('STALE_OR_REORG');});
it('unknown gas blocks ranking',()=>{expect(previewTierChoice([{...row(500),wholeSwapGas:null},row(2500)],context).status).toBe('GAS_OR_OUTPUT_UNKNOWN');});
it('XAUt denied',()=>{expect(previewTierChoice(rows(),{...context,tokenOut:'0x21cAef8A43163Eea865baeE23b9C2E327696A3bf'}).status).toBe('BLOCKED');});
it('foreign router denied',()=>{expect(previewTierChoice([{...row(500),router:W},row(2500)],context).status).toBe('CONTEXT_MISMATCH');});
it('unverified factory denied',()=>{expect(previewTierChoice([{...row(500),factoryVerified:false},row(2500)],context).status).toBe('CONTEXT_MISMATCH');});
it('paused gate blocks preview',()=>{expect(previewTierChoice(rows(),{...context,paused:true}).status).toBe('BLOCKED');});
it('chain change drops quote/review/allowance and never restores old draft',()=>{const d=new PreviewDraft();d.setQuote(previewTierChoice(rows(),context));expect(d.quote).not.toBeNull();d.setChain(677);expect(d.quote).toBeNull();expect(d.review).toBeNull();expect(d.allowance).toBeNull();d.setChain(56);expect(d.quote).toBeNull();});
it('same response cannot authorize new amount',()=>{expect(previewTierChoice(rows(),{...context,amountIn:'1000000000000001'}).status).toBe('CONTEXT_MISMATCH');});
it('zero proposal is explicitly allowed without adding real fee',()=>{const x=previewTierChoice(rows(),{...context,proposalFeeBps:0});if(!('costs'in x))throw new Error('No costs');expect(x.costs[0]?.proposalFeeOutput).toBe('0');expect(x.feeApproved).toBe(false);});
it('decimal/malformed amount blocked',()=>{expect(previewTierChoice(rows(),{...context,amountIn:'1.5'}).status).toBe('BLOCKED');});
